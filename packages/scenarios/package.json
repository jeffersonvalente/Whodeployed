{
  "name": "@whodeployed/scenarios",
  "version": "0.0.0",
  "private": true,
  "description": "Whodeployed incident scenarios: YAML data, typed loader, question patterns, repertoire and the data bundle for the game.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-data.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@whodeployed/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@whodeployed/engine": "workspace:*",
    "eslint": "^9",
    "typescript": "~5.6",
    "typescript-eslint": "^8",
    "vitest": "^2"
  }
}
