{
  "//": "Library typecheck (ADR-008, SPEC §3.6): src/ except src/cli/, ES2022 only, no DOM and no @types/node. Node-side code (CLI, tests, scripts, configs) is checked by tsconfig.node.json.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/cli"]
}
